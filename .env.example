# Shared development configuration. Copy this file to .env and replace placeholders.
ENVIRONMENT=development
# Use the Supabase Session Pooler connection string for application runtime.
# Keep the password secret and avoid committing this file with live credentials.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@<session-pooler-host>:6543/postgres?sslmode=require
# Alembic can optionally point at a direct connection if your environment needs it.
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@<direct-host>:5432/postgres?sslmode=require
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=church_admin_session
SESSION_EXPIRE_MINUTES=480
VITE_API_BASE_URL=http://localhost:8000/api/v1
